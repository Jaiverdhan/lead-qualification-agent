    {
      "parameters": {
        "jsCode": "// This parses the AI agent string output into clean JSON objects for Google Sheets\nconst inputItem = $input.first().json;\nlet rawOutput = inputItem.output || inputItem.text || \"{}\";\n\n// Clean up markdown blocks if the LLM accidentally included them\nrawOutput = rawOutput.replace(/```json/g, \"\").replace(/```/g, \"\").trim();\n\nlet parsedData;\ntry {\n  parsedData = JSON.parse(rawOutput);\n} catch (error) {\n  parsedData = {\n    product_name: \"Parsing Error\",\n    quantity: \"N/A\",\n    delivery_location: \"N/A\",\n    lead_status: \"Needs Clarification\",\n    missing_info: \"Could not parse output\",\n    agent_response: \"Could you please re-state your requirement?\"\n  };\n}\n\nreturn [{ json: parsedData }];"
      },
      "id": "a7784bc9-1d6d-4034-bd97-e0c9b1154a7f",
